# Copiez ce fichier en .env  (cp .env.example .env) puis modifiez-le.
# NE COMMITEZ JAMAIS le fichier .env (il est dans .gitignore).

# Port et interface d'écoute (127.0.0.1 = seulement ce téléphone ; 0.0.0.0 = tout le Wi-Fi)
PORT=3000
HOST=127.0.0.1

# Clé Open Charge Map (OPTIONNELLE). Sans clé, les bornes viennent d'OpenStreetMap.
# Clé gratuite : https://openchargemap.org/site/develop/api
OCM_API_KEY=

# Contact transmis aux services OSM (Nominatim/Overpass l'exigent). Mettez votre e-mail ou votre site.
USER_AGENT=RiamoCarburant/2.0 (contact: votre-email@exemple.com)

# Si le front est hébergé ailleurs que ce serveur, autorisez son origine (CORS). Vide = même origine uniquement.
ALLOW_ORIGIN=
